# PostgreSQL connection string. Supabase / Neon: use the pooled connection
# string and keep ?sslmode=require. Region: ap-south-1 (Mumbai) or nearest.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soms_dental

# Public URL of the site (used for canonical URL, Open Graph and sitemap).
NEXT_PUBLIC_SITE_URL=https://www.somsdentalcare.in

# Razorpay - Dashboard > Account & Settings > API Keys.
# Use rzp_test_... keys until KYC is complete and the site is ready to go live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay - Dashboard > Webhooks. Point the webhook at
#   https://<your-domain>/api/razorpay/webhook
# with the events payment.captured, order.paid and payment.failed, and paste
# the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string
