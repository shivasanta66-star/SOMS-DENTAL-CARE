# These are already set in Netlify (Site configuration > Environment variables).
# For local development, `netlify dev` pulls them from the linked Netlify site,
# so you normally don't need a local .env at all.

# Supabase - Project Settings > API. The secret key bypasses Row Level Security:
# it is only used inside Netlify Functions, never sent to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Razorpay - Dashboard > Account & Settings > API Keys (test mode: rzp_test_...).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Razorpay - Dashboard > Webhooks, pointed at
#   https://<your-domain>/api/razorpay/webhook
# Without it, unconfirmed payments are still checked with Razorpay every 10 minutes.
# RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Optional. Public URL for canonical links, Open Graph and the sitemap.
# Defaults to Netlify's own URL variable.
# NEXT_PUBLIC_SITE_URL=https://www.somsdentalcare.in
